# =============================================================================
# PDF Autofiller — Environment Configuration
# =============================================================================
# Copy this file to `.env` and adjust values for your environment.
#
#   cp .env.example .env
#
# Production: always set a strong API_AUTH_TOKEN and keep API_AUTH_ENABLED=true.
# Local dev:  API_AUTH_ENABLED=false is acceptable on trusted machines only.
# =============================================================================

# -----------------------------------------------------------------------------
# Optional AI features
# -----------------------------------------------------------------------------
# Leave blank to run deterministic-only (no external API calls).
MODEL_PROVIDER_API_KEY=your_model_provider_api_key_here

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API authentication (secure by default)
# -----------------------------------------------------------------------------
API_AUTH_ENABLED=true
API_AUTH_TOKEN=replace_with_strong_random_value
API_KEY_HEADER=X-API-Key

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
# 5 MB default — raise for large government packets if needed.
MAX_UPLOAD_BYTES=5242880

# -----------------------------------------------------------------------------
# Denial-of-service guards
# -----------------------------------------------------------------------------
MAX_PDF_PAGES=200
PDF_READ_TIMEOUT_SECONDS=20
MAX_PDF_TEXT_CHARS=2000000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Per-client POST /fill budget per minute. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=60

# Trust X-Forwarded-For when running behind a reverse proxy/load balancer.
TRUST_PROXY_HEADERS=false

# Optional directory of JSON alias packs (must be an existing directory).
# FORM_ALIASES_DIR=./custom_aliases

# -----------------------------------------------------------------------------
# PyPI publish (local only — for GitHub Actions use repo secret PYPI_API_TOKEN)
# -----------------------------------------------------------------------------
# PYPI_API_TOKEN=pypi-your-token-here

# ---------------------------------------------------------------------------
# Multi-key authentication (optional)
# ---------------------------------------------------------------------------
# API_AUTH_TOKEN above is the single-key form and still works. API_KEYS lets you
# issue a named key per caller so usage is attributable in the audit log and one
# key can be rotated without disturbing the others.
# Format: name:secret,name:secret
# API_KEYS=ops:replace_me,ci:replace_me_too

# ---------------------------------------------------------------------------
# Request payload bounds
# ---------------------------------------------------------------------------
# The JSON accompanying an upload is bounded separately from the PDF itself.
MAX_USER_DATA_BYTES=262144
MAX_USER_DATA_KEYS=500
MAX_USER_DATA_DEPTH=8

# Maximum documents in a single batch submission.
MAX_BATCH_ITEMS=50

# ---------------------------------------------------------------------------
# Model provider (only used when semantic inference is enabled)
# ---------------------------------------------------------------------------
MODEL_PROVIDER_MODEL=gpt-4o-mini
MODEL_PROVIDER_TIMEOUT_SECONDS=30
MODEL_PROVIDER_MAX_RETRIES=2
# Fields per inference request. One request covers the whole form up to this
# size; larger forms are split so no single call exceeds the context window.
MODEL_PROVIDER_BATCH_SIZE=40

# Inferred semantics are cached per form fingerprint, so the same form filled
# repeatedly infers once. Set to 0 to disable.
SEMANTICS_CACHE_SIZE=128

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where templates and profiles live. Defaults to ~/.pdf-autofiller
# PDF_AUTOFILLER_STATE_DIR=/var/lib/pdf-autofiller

# ---------------------------------------------------------------------------
# Browser access
# ---------------------------------------------------------------------------
# CORS is off unless you list origins. There is deliberately no wildcard
# default: it would let any page on the internet drive a deployment a browser
# has already authenticated.
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com

# Prometheus metrics at GET /metrics.
METRICS_ENABLED=true
