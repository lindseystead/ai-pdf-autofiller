# =============================================================================
# PDF Autofiller — Environment Configuration
# =============================================================================
# Copy this file to `.env` and adjust values for your environment.
#
#   cp .env.example .env
#
# Production: always set a strong API_AUTH_TOKEN and keep API_AUTH_ENABLED=true.
# Local dev:  API_AUTH_ENABLED=false is acceptable on trusted machines only.
# =============================================================================

# -----------------------------------------------------------------------------
# Optional AI features
# -----------------------------------------------------------------------------
# Leave blank to run deterministic-only (no external API calls).
MODEL_PROVIDER_API_KEY=your_model_provider_api_key_here

# Model pinned deliberately: an unpinned alias would let the provider change
# inference behavior underneath a deterministic-first service.
MODEL_NAME=gpt-4o-mini
# Classification task — sampling adds variance without benefit.
MODEL_TEMPERATURE=0.0
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
# Fields described per inference call. Batching keeps a form to one or two
# round trips instead of one call per field.
MODEL_SEMANTIC_BATCH_SIZE=40
# Untrusted page text forwarded per field.
MODEL_CONTEXT_CHAR_LIMIT=500

# Cap on any confidence a model reports about its own output. Defaults BELOW
# MAPPING_REVIEW_THRESHOLD on purpose: model self-confidence is not calibrated
# and must not clear a review gate by itself. Raising this above the threshold
# opts into writing model-chosen values unattended.
MODEL_CONFIDENCE_CEILING=0.75
MAPPING_REVIEW_THRESHOLD=0.80

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API authentication (secure by default)
# -----------------------------------------------------------------------------
API_AUTH_ENABLED=true
API_AUTH_TOKEN=replace_with_strong_random_value
API_KEY_HEADER=X-API-Key

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
# 5 MB default — raise for large government packets if needed.
MAX_UPLOAD_BYTES=5242880

# -----------------------------------------------------------------------------
# Denial-of-service guards
# -----------------------------------------------------------------------------
MAX_PDF_PAGES=200
PDF_READ_TIMEOUT_SECONDS=20
# Additional budget when a request opts into provider features. Model latency
# is not parsing time and must not share the parsing clock.
SEMANTIC_TIMEOUT_SECONDS=45
MAX_PDF_TEXT_CHARS=2000000

# Bounded worker pool. A timed-out job keeps its slot until it truly finishes,
# so excess load is shed with 503 server_busy rather than piling up.
PDF_WORKER_THREADS=4
PDF_QUEUE_DEPTH=4

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Per-client POST /fill budget per minute. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=60

# Trust X-Forwarded-For when running behind a reverse proxy/load balancer.
TRUST_PROXY_HEADERS=false

# Optional directory of JSON alias packs (must be an existing directory).
# FORM_ALIASES_DIR=./custom_aliases

# -----------------------------------------------------------------------------
# PyPI publish (local only — for GitHub Actions use repo secret PYPI_API_TOKEN)
# -----------------------------------------------------------------------------
# PYPI_API_TOKEN=pypi-your-token-here
